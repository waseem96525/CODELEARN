# ---------------------------------------------------------------------------
# Local development
#
# Production runs on PostgreSQL, and so does local development â€” the schema in
# prisma/schema.prisma declares a single datasource provider, and SQLite cannot
# be used for a Vercel deployment (its filesystem is ephemeral and read-only).
#
# Any hosted Postgres works: Neon, Supabase, Vercel Postgres, or a local server.
# The two most common URLs look like this:
#   Neon:      postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/codelearn?sslmode=require
#   Local:     postgresql://postgres:postgres@localhost:5432/codelearn
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codelearn?schema=public"

# Secret used to sign session cookies. Generate a real one for any deployed copy:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev-only-insecure-secret-change-me-before-deploying-anywhere"

# Public origin, used for canonical URLs and Open Graph tags
NEXT_PUBLIC_SITE_URL="https://codelearn-sepia.vercel.app"
